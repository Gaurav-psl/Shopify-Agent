# ---------- auth (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
RAG_API_KEY=

# ---------- Qdrant Cloud (leave QDRANT_URL empty only for local dev: embedded storage)
QDRANT_URL=https://YOUR-CLUSTER.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=store_knowledge

# ---------- dense embeddings (any OpenAI-compatible /embeddings endpoint)
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=            # optional, OpenAI v3 models only
# For multilingual-e5 style models set:  EMBED_DOC_PREFIX="passage: "  EMBED_QUERY_PREFIX="query: "

# ---------- Firecrawl (cloud, or self-hosted e.g. http://firecrawl:3002/v2)
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_API_KEY=
MAX_CRAWL_PAGES=100
# ALLOWED_CRAWL_HOSTS=store.com,www.store.com   # optional extra hosts that may be indexed besides the start URL's host

# ---------- optional: query translation / paraphrases (any OpenAI-compatible chat endpoint)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}     # Qwen3 on vLLM
DOC_LANGUAGE=en
QUERY_TRANSLATION=non_english      # off | non_english | always
QUERY_EXPANSIONS=0                 # extra paraphrases per query; costs latency, try only if the eval says it helps

# ---------- optional: reranker (Cohere / Jina / vLLM  POST {base}/rerank)
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# ---------- tuning (use eval/run_eval.py)
CHUNK_CHARS=1000
CANDIDATES=20
MIN_SCORE_DENSE=0.0
MIN_SCORE_RERANK=0.0
DEFAULT_DEADLINE_MS=4000
