# ---- Shopify Partner app credentials (Partner Dashboard > your app) ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Comma-separated. These are the permissions merchants approve on install.
SHOPIFY_SCOPES=read_products,read_orders,write_orders,read_customers
SHOPIFY_API_VERSION=2024-10

# Your deployed app's public HTTPS URL (no trailing slash).
# During local dev, use an ngrok URL, e.g. https://abcd1234.ngrok.io
APP_URL=http://localhost:8000

# Any long random string — used to sign dashboard login session cookies.
SESSION_SECRET=change-me-to-a-random-string

# Optional — defaults to a local SQLite file if unset. Use Postgres in
# production (SQLite rows vanish on most hosts' free-tier restarts).
# DATABASE_URL=postgresql+psycopg2://user:pass@host/dbname

# ---- OpenAI (used by intent_classifier.py + reply_generator.py) ----
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
